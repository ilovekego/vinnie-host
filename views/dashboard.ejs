<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Vinnie Host - Modern backend hosting and cloud deployment. Deploy GitHub backends, manage environment variables, and view live logs.">
    <meta name="keywords" content="cloud hosting, backend deployment, Heroku alternative, deploy bot, environment variables, serverless">
    <meta name="author" content="Vinnie Host">
    <meta property="og:title" content="Vinnie Host | Modern Cloud Dashboard">
    <meta property="og:description" content="Deploy bots, APIs & backends fast directly from GitHub.">
    <meta property="og:type" content="website">
    <title>Vinnie Host | Modern Cloud Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <style>
        :root {
            --bg: #000000;
            --bg-surface: #111111;
            --bg-elevated: #1a1a1a;
            --border: #333333;
            --border-focus: #555555;
            --text-primary: #ededed;
            --text-secondary: #a1a1aa;
            --accent: #ffffff;
            --accent-text: #000000;
            --success: #0070f3; 
            --warning: #f5a623;
            --danger: #e00;
            --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --font-mono: "Menlo", "Consolas", "Courier New", monospace;
        }

        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--border-focus);
        }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background-color: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            line-height: 1.5;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .glass {
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .top-nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 0 5%;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: rgba(0, 0, 0, 0.8);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(12px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            font-size: 1.125rem;
            letter-spacing: -0.02em;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 6px;
            background-color: var(--accent);
            color: var(--accent-text);
        }

        .nav-links {
            display: flex;
            gap: 24px;
            align-items: center;
            margin-left: 32px;
            flex-grow: 1;
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.875rem;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: var(--text-primary);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .slot-pill {
            border: 1px solid var(--border);
            background-color: var(--bg-surface);
            color: var(--text-secondary);
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid var(--border);
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 1.25rem;
            cursor: pointer;
            padding: 4px;
        }

        .mobile-menu {
            display: none;
            padding: 16px 5%;
            background-color: var(--bg);
            border-bottom: 1px solid var(--border);
        }

        .mobile-menu a {
            display: block;
            padding: 12px 0;
            color: var(--text-secondary);
            font-size: 0.875rem;
            border-bottom: 1px solid var(--border);
        }

        .mobile-menu a:last-child {
            border-bottom: none;
        }

        .container {
            width: 100%;
            max-width: 1048px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .hero {
            padding: 80px 0;
            text-align: center;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--border);
            background-color: var(--bg-surface);
            color: var(--text-secondary);
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 24px;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            letter-spacing: -0.04em;
            margin: 0 0 16px;
            line-height: 1.1;
        }

        .hero p {
            color: var(--text-secondary);
            font-size: 1.125rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .hero-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-top: 32px;
        }

        .btn {
            border: none;
            cursor: pointer;
            border-radius: 6px;
            padding: 0 16px;
            height: 40px;
            font-size: 0.875rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background-color: var(--accent);
            color: var(--accent-text);
        }

        .btn-primary:hover:not(:disabled) {
            opacity: 0.9;
        }

        .btn-secondary {
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--text-primary);
        }

        .btn-secondary:hover {
            border-color: var(--border-focus);
        }

        .btn-success {
            background-color: var(--success);
            color: white;
        }

        .btn-danger {
            background-color: var(--bg);
            color: var(--danger);
            border: 1px solid var(--danger);
        }
        
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin: 0 0 64px;
        }

        .stat-card {
            padding: 24px;
            border-radius: 8px;
        }

        .stat-card h3 {
            margin: 0;
            font-size: 2rem;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .stat-card p {
            margin: 4px 0 0;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        .section {
            padding: 48px 0;
            border-top: 1px solid var(--border);
        }

        .section-title {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .section-title h2 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .section-title p {
            color: var(--text-secondary);
            font-size: 0.875rem;
            margin: 4px 0 0;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 24px;
        }

        .card {
            padding: 24px;
        }

        .card h3 {
            margin: 0 0 16px;
            font-size: 1rem;
            font-weight: 500;
        }

        .input-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            color: var(--text-secondary);
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
        }

        input, select, textarea {
            width: 100%;
            padding: 0 12px;
            height: 40px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background-color: var(--bg);
            color: var(--text-primary);
            font-family: var(--font-mono);
            font-size: 0.875rem;
            outline: none;
            transition: border-color 0.2s ease;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--border-focus);
        }

        .search-wrap {
            display: flex;
            gap: 8px;
        }
        
        .search-wrap input {
            flex-grow: 1;
        }

        .dynamic-area {
            margin-top: 24px;
            border-top: 1px solid var(--border);
            padding-top: 24px;
            display: none;
        }

        .name-gen {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background-color: var(--bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            margin-bottom: 16px;
        }

        .identity {
            font-family: var(--font-mono);
            font-size: 0.875rem;
            color: var(--text-primary);
        }

        .toggle-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            font-size: 0.875rem;
        }

        .toggle-box input[type="checkbox"] {
            width: auto;
            height: auto;
            margin: 0;
        }

        .env-row {
            display: grid;
            grid-template-columns: 1fr 2fr auto;
            gap: 8px;
            margin-bottom: 8px;
        }

        .small-btn {
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            border-radius: 6px;
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .small-btn:hover {
            border-color: var(--border-focus);
            color: var(--text-primary);
        }
        
        .small-btn.danger:hover {
            color: var(--danger);
            border-color: var(--danger);
        }

        .plan-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
        }

        .plan-card {
            padding: 24px;
            border-radius: 8px;
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
        }

        .plan-card.featured {
            border-color: var(--text-secondary);
        }

        .plan-card h3 {
            font-size: 1rem;
            font-weight: 500;
            margin: 0 0 8px;
        }

        .plan-price {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .plan-card ul {
            padding-left: 16px;
            margin: 0;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        .app-list {
            display: flex;
            flex-direction: column;
            gap: 1px;
            background-color: var(--border);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
        }

        .app-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            background-color: var(--bg-surface);
        }

        .app-name {
            font-weight: 500;
            font-size: 0.875rem;
            margin-bottom: 4px;
        }

        .app-url {
            color: var(--text-secondary);
            font-size: 0.75rem;
            font-family: var(--font-mono);
        }
        
        .app-actions {
            display: flex;
            gap: 8px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-primary);
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 12px;
        }

        .pulse {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--success);
        }

        .terminal-wrapper {
            background-color: var(--bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
        }

        .terminal {
            padding: 16px;
            font-family: var(--font-mono);
            font-size: 0.8125rem;
            color: var(--text-secondary);
            height: 400px;
            overflow-y: auto;
            white-space: pre-wrap;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .feature-card {
            padding: 24px;
        }

        .feature-card i {
            font-size: 1.25rem;
            color: var(--text-primary);
            margin-bottom: 12px;
        }

        .feature-card h3 {
            font-size: 1rem;
            font-weight: 500;
            margin: 0 0 8px;
        }

        .feature-card p {
            color: var(--text-secondary);
            font-size: 0.875rem;
            margin: 0;
        }

        .auth-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
        }

        .auth-prompt {
            width: 100%;
            max-width: 400px;
            padding: 32px;
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            text-align: center;
        }

        .auth-prompt h2 {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0 0 8px;
        }

        .promo-text {
            color: var(--text-secondary);
            font-size: 0.875rem;
            margin: 0 0 16px;
        }

        .floating-success {
            display: none;
            margin-top: 16px;
            padding: 16px;
            border: 1px solid var(--border);
            background-color: var(--bg);
            border-radius: 6px;
        }
        
        .floating-success b {
            display: block;
            margin-bottom: 4px;
            font-weight: 500;
            font-size: 0.875rem;
        }

        .footer {
            padding: 32px 0 64px;
            color: var(--text-secondary);
            text-align: center;
            font-size: 0.875rem;
            border-top: 1px solid var(--border);
        }

        @media (max-width: 1024px) {
            .nav-links {
                display: none;
            }
            
            .mobile-menu-btn {
                display: block;
            }
            
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .plan-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .feature-grid {
                grid-template-columns: 1fr;
            }
            
            .env-row {
                grid-template-columns: 1fr;
            }
            
            .app-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }
            
            .search-wrap {
                flex-direction: column;
            }
            
            .search-wrap button {
                width: 100%;
            }
        }
        
        @media (max-width: 480px) {
            .stats-grid, .plan-grid {
                grid-template-columns: 1fr;
            }
            
            .slot-pill {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="auth-overlay" id="auth-gate">
        <div class="auth-prompt">
            <div style="display: flex; justify-content: flex-end; margin-bottom: 16px;">
                <button onclick="closeAuth()" class="small-btn"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <h2>Access Vinnie Host</h2>
            <p class="promo-text">
                Sign in to deploy backends, manage environment variables, view logs, and get live hosting URLs.
            </p>

            <a href="/auth/github" class="btn btn-secondary" style="width:100%; margin-bottom: 8px;">
                <i class="fa-brands fa-github"></i> Continue with GitHub
            </a>
            <a href="/auth/google" class="btn btn-secondary" style="width:100%;">
                <i class="fa-brands fa-google"></i> Continue with Google
            </a>
        </div>
    </div>

    <nav class="top-nav">
        <a href="#home" class="brand">
            <div class="brand-icon"><i class="fa-solid fa-cloud"></i></div>
            <span>Vinnie Host</span>
        </a>

        <div class="nav-links">
            <a href="#deploy">Deploy</a>
            <a href="#apps">Apps</a>
            <a href="#logs">Logs</a>
            <a href="#plans">Plans</a>
            <a href="#features">Features</a>
            <a href="#env">Env Vars</a>
            <a href="#official">Official</a>
        </div>

        <div class="nav-right">
            <span class="slot-pill">Global Units: <%= totalDeployed %>/100</span>
            <% if (user) { %>
                <img src="<%= user.avatar %>" class="avatar" alt="User avatar">
                <a href="/logout" class="small-btn" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
            <% } else { %>
                <button onclick="triggerAuth()" class="btn btn-secondary">
                    Sign In
                </button>
            <% } %>
            <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
        <a href="#deploy" onclick="toggleMobileMenu()">Deploy</a>
        <a href="#apps" onclick="toggleMobileMenu()">Apps</a>
        <a href="#logs" onclick="toggleMobileMenu()">Logs</a>
        <a href="#plans" onclick="toggleMobileMenu()">Plans</a>
        <a href="#features" onclick="toggleMobileMenu()">Features</a>
        <a href="#env" onclick="toggleMobileMenu()">Env Vars</a>
        <a href="#official" onclick="toggleMobileMenu()">Official Bot</a>
        <a href="#support" onclick="toggleMobileMenu()">Support</a>
    </div>

    <main class="container">
        <section class="hero" id="home">
            <span class="badge">Modern backend hosting</span>
            <h1>Deploy backends fast.</h1>
            <p>
                Welcome, <b><%= user ? user.displayName : 'Guest' %></b>. Deploy GitHub repositories, 
                manage environment variables, monitor build logs, and access clean app URLs.
            </p>
            <div class="hero-actions">
                <button onclick="checkAndAction(() => document.getElementById('deploy').scrollIntoView())" class="btn btn-primary">
                    Start Deploying
                </button>
                <a href="#plans" class="btn btn-secondary">
                    View Plans
                </a>
            </div>
        </section>

        <section class="stats-grid" id="status">
            <div class="stat-card glass">
                <h3><%= totalDeployed %></h3>
                <p>Active Global Units</p>
            </div>
            <div class="stat-card glass">
                <h3 style="text-transform: capitalize;"><%= user ? (user.plan || 'free') : 'guest' %></h3>
                <p>Current Plan</p>
            </div>
            <div class="stat-card glass">
                <h3><%= user && user.deployedApps ? user.deployedApps.length : 0 %></h3>
                <p>Your Deployed Apps</p>
            </div>
            <div class="stat-card glass">
                <h3>24/7</h3>
                <p>Cloud Access</p>
            </div>
        </section>

        <section class="section" id="deploy">
            <div class="section-title">
                <div>
                    <h2>Deploy Center</h2>
                    <p>Paste any public GitHub repository, or connect your account for private repos.</p>
                </div>
            </div>

            <div class="dashboard-grid">
                <div class="card glass">
                    <h3>Repository Scanner</h3>
                    <p class="promo-text">
                        If your repo has an <b>app.json</b>, variables are loaded automatically. Otherwise, add them manually.
                    </p>

                    <div class="input-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label style="margin-bottom: 0;">GitHub Repository URL</label>
                            <% if(user && !user.githubId) { %>
                                <a href="/auth/github" class="small-btn" style="height: 28px; width: auto; padding: 0 12px; font-size: 0.75rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                    <i class="fa-brands fa-github"></i> Connect GitHub
                                </a>
                            <% } %>
                        </div>

                        <% if(user && user.githubId) { %>
                            <select id="repo-dropdown" style="margin-bottom: 12px; color: var(--text-secondary);" onchange="if(this.value) document.getElementById('repoUrl').value = this.value;">
                                <option value="">Loading your repositories...</option>
                            </select>
                        <% } %>

                        <div class="search-wrap">
                            <input type="text" id="repoUrl" placeholder="https://github.com/user/public-repo" value="">
                            <button class="btn btn-secondary" id="scan-btn" onclick="checkAndAction(scanBlueprint)">
                                Scan
                            </button>
                        </div>
                        <p class="promo-text" style="margin-top: 8px; font-size: 0.75rem;">
                            Paste any public repository URL, or select from your connected GitHub account above.
                        </p>
                    </div>

                    <div id="dynamic-area" class="dynamic-area">
                        <div class="name-gen">
                            <div>
                                <label style="margin-bottom:4px;">App Identity</label>
                                <div class="identity" id="display-app-name"></div>
                            </div>
                            <button class="small-btn" onclick="rotateName()" title="Rotate Identity">
                                <i class="fa-solid fa-rotate"></i>
                            </button>
                        </div>

                        <div class="toggle-box">
                            <span>Force Procfile Startup</span>
                            <input type="checkbox" id="procfile-toggle" checked>
                        </div>

                        <div id="dynamic-inputs" style="max-height: 310px; overflow-y: auto; margin: 16px 0;"></div>

                        <button class="btn btn-secondary" style="width:100%; margin-bottom:12px;" onclick="addEnvRow()">
                            Add Env Variable
                        </button>

                        <button class="btn btn-primary" id="launch-btn" style="width:100%;" disabled>
                            Deploy Now
                        </button>

                        <div id="deploy-success" class="floating-success">
                            <b>Deployment Started</b>
                            <p class="promo-text" style="margin-bottom: 12px;">Your app is building. Use the logs panel to monitor.</p>
                            <a id="live-url" class="app-url" target="_blank" style="display:block; margin-bottom:12px;"></a>
                            <button class="btn btn-secondary" style="width:100%; height:32px; font-size:0.75rem;" onclick="copyLiveUrl()">
                                Copy URL
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card glass" id="official">
                    <h3>Official COMRADES-MD-BOT</h3>
                    <p class="promo-text">
                        Your plan reserves a deployment slot specifically for the official bot repository:
                        <br><span style="font-family: var(--font-mono); color: var(--text-primary);">Vinny256/COMRADES-MD-BOT</span>
                    </p>

                    <button class="btn btn-secondary" style="width:100%; margin: 16px 0 24px;" onclick="checkAndAction(quickDeployOfficial)">
                        Quick Deploy Bot
                    </button>

                    <hr style="border:0; border-top:1px solid var(--border); margin:0 0 24px;">

                    <h3>Current Unit</h3>
                    <% if(user && user.hasDeployed) { %>
                        <div class="status"><span class="pulse"></span> ONLINE</div>
                        <p class="promo-text" style="margin-bottom: 4px;">Latest ID: <span style="color:var(--text-primary);"><%= user.activeUnit %></span></p>
                        <p class="app-url" style="margin-bottom: 16px;">https://<%= user.activeUnit %>.gathuo.app</p>
                        <div style="display:flex; flex-direction:column; gap:8px;">
                            <button class="btn btn-secondary" onclick="openApp('<%= user.activeUnit %>')">
                                Open Live App
                            </button>
                            <button class="btn btn-secondary" onclick="copyText('https://<%= user.activeUnit %>.gathuo.app')">
                                Copy URL
                            </button>
                            <button class="btn btn-secondary" onclick="loadConfig('<%= user.activeUnit %>')">
                                Edit Env Vars
                            </button>
                            <button class="btn btn-danger" onclick="terminateUnit('<%= user.activeUnit %>')">
                                Terminate Unit
                            </button>
                        </div>
                    <% } else { %>
                        <p class="promo-text">No active deployment yet.</p>
                    <% } %>
                </div>
            </div>
        </section>

        <section class="section" id="apps">
            <div class="section-title">
                <div>
                    <h2>Your Apps</h2>
                    <p>Manage deployed units, edit configurations, or terminate instances.</p>
                </div>
            </div>

            <% if(user && user.deployedApps && user.deployedApps.length) { %>
                <div class="app-list">
                    <% user.deployedApps.forEach(function(app) { %>
                        <div class="app-item">
                            <div>
                                <div class="app-name"><%= app.appName %></div>
                                <div class="app-url">https://<%= app.appName %>.gathuo.app</div>
                                <div class="promo-text" style="margin-top: 4px;">Repo: <%= app.repoUrl %></div>
                            </div>
                            <div class="app-actions">
                                <button class="small-btn" onclick="openApp('<%= app.appName %>')" title="Open App"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>
                                <button class="small-btn" onclick="copyText('https://<%= app.appName %>.gathuo.app')" title="Copy URL"><i class="fa-solid fa-copy"></i></button>
                                <button class="small-btn" onclick="loadConfig('<%= app.appName %>')" title="Config"><i class="fa-solid fa-gear"></i></button>
                                <button class="small-btn danger" onclick="terminateUnit('<%= app.appName %>')" title="Terminate"><i class="fa-solid fa-trash"></i></button>
                                </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="card glass">
                    <p class="promo-text">No apps deployed yet. Start by scanning a repo above.</p>
                </div>
            <% } %>
        </section>

        <section class="section" id="env">
            <div class="section-title">
                <div>
                    <h2>Environment Variables</h2>
                    <p>Edit configuration variables for your deployed applications.</p>
                </div>
            </div>

            <div class="card glass">
                <div class="input-group">
                    <label>Target App</label>
                    <input type="text" id="config-app-name" placeholder="Select 'Edit Env Vars' from your app list" readonly>
                </div>

                <div id="config-editor" style="margin: 24px 0;"></div>

                <div style="display:flex; gap:12px;">
                    <button class="btn btn-secondary" onclick="addConfigRow()">
                        Add Variable
                    </button>
                    <button class="btn btn-primary" onclick="saveConfig()">
                        Save Changes
                    </button>
                </div>
            </div>
        </section>

        <section class="section" id="logs">
            <div class="section-title">
                <div>
                    <h2>Build & Runtime Logs</h2>
                    <p>Live terminal output from your latest active unit.</p>
                </div>
                <button class="btn btn-secondary" onclick="downloadLogs()">
                    Save Output
                </button>
            </div>

            <div class="terminal-wrapper">
                <div class="terminal" id="log-stream"><% if(user && user.hasDeployed) { %>Connecting to stream for <%= user.activeUnit %>...<% } else { %>No active deployment detected. Deploy an app to view logs.<% } %></div>
            </div>
        </section>

        <section class="section" id="plans">
            <div class="section-title">
                <div>
                    <h2>Plans & Pricing</h2>
                    <p>Scalable infrastructure tiers. All plans except Gold reserve one slot for the official bot.</p>
                </div>
            </div>

            <div class="plan-grid">
                <div class="plan-card">
                    <h3>Free</h3>
                    <div class="plan-price">KSh 0</div>
                    <ul>
                        <li>2 Backend Units</li>
                        <li>1 Official Bot Slot</li>
                        <li>Standard Logs</li>
                    </ul>
                </div>

                <div class="plan-card">
                    <h3>Startup</h3>
                    <div class="plan-price">KSh 20</div>
                    <ul>
                        <li>5 Backend Units</li>
                        <li>1 Official Bot Slot</li>
                        <li>Config Editor</li>
                    </ul>
                </div>

                <div class="plan-card featured">
                    <h3>Silver</h3>
                    <div class="plan-price">KSh 50</div>
                    <ul>
                        <li>10 Backend Units</li>
                        <li>1 Official Bot Slot</li>
                        <li>Enhanced Scaling</li>
                    </ul>
                </div>

                <div class="plan-card">
                    <h3>Platinum</h3>
                    <div class="plan-price">KSh 100</div>
                    <ul>
                        <li>50 Backend Units</li>
                        <li>1 Official Bot Slot</li>
                        <li>Advanced Metrics</li>
                    </ul>
                </div>

                <div class="plan-card">
                    <h3>Gold</h3>
                    <div class="plan-price">KSh 250</div>
                    <ul>
                        <li>Unlimited Units</li>
                        <li>No Reserved Limits</li>
                        <li>Priority Support</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="section" id="features">
            <div class="section-title">
                <div>
                    <h2>Platform Features</h2>
                    <p>Engineered for streamlined developer workflows.</p>
                </div>
            </div>

            <div class="feature-grid">
                <div class="feature-card glass">
                    <i class="fa-solid fa-code-branch"></i>
                    <h3>Repo Scanner</h3>
                    <p>Detect app.json or Procfile configurations automatically.</p>
                </div>
                <div class="feature-card glass">
                    <i class="fa-solid fa-sliders"></i>
                    <h3>Env Management</h3>
                    <p>Update environment variables securely via the dashboard.</p>
                </div>
                <div class="feature-card glass">
                    <i class="fa-solid fa-terminal"></i>
                    <h3>Live Logs</h3>
                    <p>Monitor real-time build and application runtime output.</p>
                </div>
                <div class="feature-card glass">
                    <i class="fa-solid fa-globe"></i>
                    <h3>Custom Subdomains</h3>
                    <p>Apps are automatically assigned a unique gathuo.app URL.</p>
                </div>
                <div class="feature-card glass">
                    <i class="fa-solid fa-server"></i>
                    <h3>Isolated Units</h3>
                    <p>Deployments run in securely isolated container instances.</p>
                </div>
                <div class="feature-card glass">
                    <i class="fa-solid fa-shield-halved"></i>
                    <h3>OAuth Protected</h3>
                    <p>Secure account access via GitHub and Google authentication.</p>
                </div>
            </div>
        </section>

        <section class="section" id="support">
            <div class="card glass" style="text-align: center;">
                <h2 style="margin:0 0 8px; font-size:1.5rem; font-weight:600;">System Support</h2>
                <p class="promo-text" style="max-width: 500px; margin: 0 auto 24px;">
                    If a deployment fails, review the build logs, ensure your repository is public, 
                    and verify all required environment variables are set correctly.
                </p>
                <button class="btn btn-secondary" onclick="document.getElementById('logs').scrollIntoView()">
                    Access Logs
                </button>
            </div>
        </section>

        <footer class="footer">
            Vinnie Host © <%= new Date().getFullYear() %> — Cloud deployment platform.
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        const isLoggedIn = <%= user ? 'true' : 'false' %>;
        let currentGeneratedName = `vinnie-${Math.random().toString(36).substring(2, 7)}`;
        let latestLiveUrl = "";

        function triggerAuth() {
            document.getElementById('auth-gate').style.display = 'flex';
        }

        function closeAuth() {
            document.getElementById('auth-gate').style.display = 'none';
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function checkAndAction(cb) {
            isLoggedIn ? cb() : triggerAuth();
        }

        function showToast(text, color = "var(--border-focus)") {
            Toastify({
                text,
                duration: 3200,
                gravity: "bottom",
                position: "right",
                style: {
                    background: "var(--bg-surface)",
                    color: "var(--text-primary)",
                    border: `1px solid ${color}`,
                    borderRadius: "6px",
                    boxShadow: "0 4px 12px rgba(0,0,0,0.5)",
                    fontFamily: "var(--font-sans)",
                    fontSize: "0.875rem"
                }
            }).showToast();
        }

        function rotateName() {
            currentGeneratedName = `vinnie-${Math.random().toString(36).substring(2, 7)}`;
            const display = document.getElementById('display-app-name');
            if (display) display.innerText = currentGeneratedName;
            showToast("Identity rotated", "var(--text-secondary)");
        }

        async function quickDeployOfficial() {
            const repo = document.getElementById('repoUrl');
            if (!repo) return;
            repo.value = "https://github.com/Vinny256/COMRADES-MD-BOT";
            document.getElementById('deploy').scrollIntoView();
            scanBlueprint();
        }

        async function scanBlueprint() {
            const repoUrl = document.getElementById('repoUrl').value.trim();
            if (!repoUrl) return showToast("Enter a repository URL", "var(--danger)");

            const scanBtn = document.getElementById('scan-btn');
            scanBtn.disabled = true;
            scanBtn.innerText = 'Scanning...';

            try {
                const res = await fetch('/deploy/scan', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ repoUrl })
                });

                const data = await res.json();

                if (data.success) {
                    const inputContainer = document.getElementById('dynamic-inputs');
                    inputContainer.innerHTML = '';

                    rotateName();

                    if (!data.requirements || data.requirements.length === 0) {
                        inputContainer.innerHTML = '<p class="promo-text">No config variables found. Add them manually below.</p>';
                        addEnvRow();
                    } else {
                        data.requirements.forEach(item => {
                            if (item.key !== 'HEROKU_API_KEY') createVarInput(inputContainer, item.key, item.value, item.description);
                        });
                    }

                    document.getElementById('dynamic-area').style.display = 'block';
                    document.getElementById('launch-btn').onclick = () => launchToGrid(data.repo);
                    validateForm();
                    showToast("Scan complete", "var(--success)");
                } else {
                    document.getElementById('dynamic-area').style.display = 'block';
                    document.getElementById('dynamic-inputs').innerHTML = '<p class="promo-text">No configuration file found. Add variables manually.</p>';
                    document.getElementById('launch-btn').onclick = () => launchToGrid(repoUrl);
                    rotateName();
                    validateForm();
                    showToast(data.message || "Manual mode ready", "var(--warning)");
                }
            } catch (e) {
                showToast("Scan failed", "var(--danger)");
            } finally {
                scanBtn.disabled = false;
                scanBtn.innerText = 'Scan';
            }
        }

        function createVarInput(container, key, val, desc) {
            const div = document.createElement('div');
            div.className = 'env-row';
            div.innerHTML = `
                <input type="text" class="env-key-input" value="${escapeHtml(key || '')}" placeholder="KEY">
                <input type="text" class="env-var-input" value="${escapeHtml(val || '')}" placeholder="${escapeHtml(desc || 'VALUE')}">
                <button class="small-btn" onclick="this.parentElement.remove(); validateForm();"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
            div.querySelectorAll('input').forEach(input => input.addEventListener('input', validateForm));
        }

        function addEnvRow() {
            const container = document.getElementById('dynamic-inputs');
            createVarInput(container, "", "", "");
            validateForm();
        }

        function validateForm() {
            const launchBtn = document.getElementById('launch-btn');
            if (!launchBtn) return;

            const rows = document.querySelectorAll('#dynamic-inputs .env-row');
            let valid = true;

            rows.forEach(row => {
                const key = row.querySelector('.env-key-input')?.value.trim();
                const value = row.querySelector('.env-var-input')?.value.trim();
                if (!key || !value) valid = false;
            });

            launchBtn.disabled = !valid;
        }

        async function launchToGrid(repoUrl) {
            const configVars = { "APP_NAME": currentGeneratedName };

            document.querySelectorAll('#dynamic-inputs .env-row').forEach(row => {
                const key = row.querySelector('.env-key-input')?.value.trim();
                const value = row.querySelector('.env-var-input')?.value.trim();
                if (key) configVars[key] = value;
            });

            if (document.getElementById('procfile-toggle').checked) {
                configVars["USE_PROCFILE"] = "true";
            }

            const launchBtn = document.getElementById('launch-btn');
            launchBtn.disabled = true;
            launchBtn.innerText = 'Deploying...';

            try {
                const res = await fetch('/deploy/launch', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ repoUrl, configVars })
                });

                const data = await res.json();

                if (data.success) {
                    latestLiveUrl = data.customUrl || `https://${data.appName}.gathuo.app`;
                    document.getElementById('deploy-success').style.display = 'block';
                    document.getElementById('live-url').innerText = latestLiveUrl;
                    document.getElementById('live-url').href = latestLiveUrl;
                    showToast("Deployment initialized", "var(--success)");

                    setTimeout(() => {
                        window.location.reload();
                    }, 2500);
                } else {
                    showToast(data.message || "Deployment failed", "var(--danger)");
                }
            } catch (e) {
                showToast("Request failed", "var(--danger)");
            } finally {
                launchBtn.disabled = false;
                launchBtn.innerText = 'Deploy Now';
            }
        }

        async function terminateUnit(appName) {
            if (!confirm("Terminate this unit permanently?")) return;

            const res = await fetch('/deploy/terminate', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ appName })
            });

            const data = await res.json();

            if (data.success) {
                showToast("Unit terminated", "var(--success)");
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast(data.message || "Termination failed", "var(--danger)");
            }
        }

        function openApp(appName) {
            window.open(`https://${appName}.gathuo.app`, '_blank');
        }

        function copyText(text) {
            navigator.clipboard.writeText(text);
            showToast("Copied to clipboard", "var(--border-focus)");
        }

        function copyLiveUrl() {
            if (!latestLiveUrl) return;
            copyText(latestLiveUrl);
        }

        async function loadConfig(appName) {
            document.getElementById('env').scrollIntoView();
            document.getElementById('config-app-name').value = appName;
            const editor = document.getElementById('config-editor');
            editor.innerHTML = '<p class="promo-text">Fetching configuration...</p>';

            try {
                const res = await fetch(`/deploy/config/${appName}`);
                const data = await res.json();

                editor.innerHTML = "";
                const config = data.config || {};

                Object.keys(config).forEach(key => {
                    addConfigRow(key, config[key]);
                });

                if (Object.keys(config).length === 0) {
                    editor.innerHTML = '<p class="promo-text">No variables found. Add new ones below.</p>';
                }

                showToast("Configuration loaded", "var(--success)");
            } catch (e) {
                editor.innerHTML = '<p class="promo-text" style="color:var(--danger);">Failed to load configuration.</p>';
            }
        }

        function addConfigRow(key = "", value = "") {
            const editor = document.getElementById('config-editor');
            const row = document.createElement('div');
            row.className = 'env-row';
            row.innerHTML = `
                <input type="text" class="config-key" value="${escapeHtml(key)}" placeholder="KEY">
                <input type="text" class="config-value" value="${escapeHtml(value)}" placeholder="VALUE">
                <button class="small-btn" onclick="this.parentElement.remove();"><i class="fa-solid fa-trash"></i></button>
            `;
            editor.appendChild(row);
        }

        async function saveConfig() {
            const appName = document.getElementById('config-app-name').value.trim();
            if (!appName) return showToast("Select an app to configure", "var(--danger)");

            const body = {};
            document.querySelectorAll('#config-editor .env-row').forEach(row => {
                const key = row.querySelector('.config-key')?.value.trim();
                const value = row.querySelector('.config-value')?.value.trim();
                if (key) body[key] = value;
            });

            try {
                const res = await fetch(`/deploy/config/${appName}`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(body)
                });
                const data = await res.json();

                if (data.updated || data.success) {
                    showToast("Configuration saved", "var(--success)");
                } else {
                    showToast("Failed to save configuration", "var(--danger)");
                }
            } catch (e) {
                showToast("Network error", "var(--danger)");
            }
        }

        function downloadLogs() {
            const logElement = document.getElementById('log-stream');
            if (!logElement) return;

            const blob = new Blob([logElement.innerText], { type: 'text/plain' });
            const elem = window.document.createElement('a');
            elem.href = window.URL.createObjectURL(blob);
            elem.download = 'vinnie-host-logs.txt';
            document.body.appendChild(elem);
            elem.click();
            document.body.removeChild(elem);
        }

        function escapeHtml(str) {
            return String(str)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        <% if(user && user.hasDeployed) { %>
            let lastLogs = "";
            setInterval(() => {
                fetch('/deploy/logs/<%= user.activeUnit %>')
                    .then(res => res.json())
                    .then(data => {
                        const lb = document.getElementById('log-stream');
                        if (lb && data.logs && data.logs !== lastLogs) {
                            lastLogs = data.logs;
                            lb.innerText = data.logs;
                            lb.scrollTop = lb.scrollHeight;
                        }
                    })
                    .catch(() => {});
            }, 5000);
        <% } %>

        <% if(user && user.githubId) { %>
            fetch('/deploy/github-repos')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('repo-dropdown');
                    if(data.success && data.repos && data.repos.length > 0) {
                        select.innerHTML = '<option value="">-- Select from your GitHub (Auto-fills below) --</option>';
                        data.repos.forEach(repo => {
                            select.innerHTML += `<option value="${repo.url}">${repo.private ? '🔒' : '🌎'} ${repo.name}</option>`;
                        });
                    } else {
                        select.innerHTML = '<option value="">No repositories found. Paste URL below.</option>';
                    }
                })
                .catch(() => {
                    const select = document.getElementById('repo-dropdown');
                    if(select) select.innerHTML = '<option value="">Failed to load repos. Paste URL below.</option>';
                });
        <% } %>
    </script>
</body>
</html>
