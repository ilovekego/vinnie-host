    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        const isLoggedIn = <%= user ? 'true' : 'false' %>;
        let currentGeneratedName = `vinnie-${Math.random().toString(36).substring(2, 7)}`;
        let latestLiveUrl = "";
        let globalRepos = [];

        // --- THEME ENGINE (Strict System Default) ---
        function setTheme(theme) {
            localStorage.setItem('vinnie_theme', theme);
            document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(`btn-${theme}`).classList.add('active');

            if (theme === 'system') {
                const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
            } else {
                document.documentElement.setAttribute('data-theme', theme);
            }
        }

        (function initTheme() {
            const saved = localStorage.getItem('vinnie_theme') || 'system';
            setTheme(saved);
        })();

        // Listen for OS theme changes if on system default
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
            if (localStorage.getItem('vinnie_theme') === 'system') {
                document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
        });

        // --- DESKTOP SIDEBAR COLLAPSE TOGGLE ---
        function toggleDesktopCollapse() {
            if (window.innerWidth <= 1024) return; // Prevent collapse logic on mobile
            const sidebar = document.getElementById('sidebar');
            const body = document.body;
            const arrow = document.getElementById('collapse-arrow');
            sidebar.classList.toggle('collapsed');
            body.classList.toggle('collapsed-sidebar');
            const isCollapsed = sidebar.classList.contains('collapsed');
            arrow.className = isCollapsed ? 'fa-solid fa-chevron-right' : 'fa-solid fa-chevron-left';
            localStorage.setItem('vinnie_sidebar_collapsed', isCollapsed);
        }

        (function initSidebarState() {
            if (window.innerWidth > 1024) {
                if (localStorage.getItem('vinnie_sidebar_collapsed') === 'true') {
                    document.getElementById('sidebar').classList.add('collapsed');
                    document.body.classList.add('collapsed-sidebar');
                    document.getElementById('collapse-arrow').className = 'fa-solid fa-chevron-right';
                }
            }
        })();

        // --- MOBILE MENU BEHAVIOR ---
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('menu-overlay');
            const isOpen = sidebar.classList.toggle('open');
            overlay.style.display = isOpen ? 'block' : 'none';
        }

        function closeSidebarMobile() {
            if (window.innerWidth <= 1024) toggleSidebar();
        }

        // --- AUTH & MODALS ---
        function triggerAuth() { document.getElementById('auth-gate').style.display = 'flex'; }
        function closeAuth() { document.getElementById('auth-gate').style.display = 'none'; }
        function openSettings() { document.getElementById('settings-modal').style.display = 'flex'; closeSidebarMobile(); }
        function closeSettings() { document.getElementById('settings-modal').style.display = 'none'; }
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function handleOAuth(url) {
            const check = document.getElementById('terms-check');
            if (!check || !check.checked) {
                showToast("You must accept the Terms of Service and Privacy Policy to continue.", "var(--danger)");
                return;
            }
            window.location.href = url;
        }

        function checkAndAction(cb) { isLoggedIn ? cb() : triggerAuth(); }

        function showToast(text, color = "var(--border-focus)") {
            Toastify({
                text, duration: 3200, gravity: "bottom", position: "right",
                style: { background: "var(--bg-surface)", color: "var(--text-primary)", border: `1px solid ${color}`, borderRadius: "8px", fontSize: "0.9rem", boxShadow: "0 10px 20px rgba(0,0,0,0.2)" }
            }).showToast();
        }

        function rotateName() {
            currentGeneratedName = `vinnie-${Math.random().toString(36).substring(2, 7)}`;
            const display = document.getElementById('display-app-name');
            if (display) display.innerText = currentGeneratedName;
            showToast("Identity rotated", "var(--text-secondary)");
        }

        async function quickDeployOfficial() {
            const repo = document.getElementById('repoUrl');
            if (!repo) return;
            repo.value = "https://github.com/Vinny256/COMRADES-MD-BOT";
            document.getElementById('deploy').scrollIntoView();
            scanBlueprint();
        }

        // --- RENDER-STYLE REPO PICKER LOGIC ---
        function toggleRepoDropdown() {
            const card = document.getElementById('repo-dropdown-card');
            if (!card) return;
            const isOpen = card.style.display === 'block';
            card.style.display = isOpen ? 'none' : 'block';
            if (!isOpen) document.getElementById('repo-search-box').focus();
        }

        window.addEventListener('click', (e) => {
            const picker = document.getElementById('repo-picker');
            if (picker && !picker.contains(e.target)) {
                const card = document.getElementById('repo-dropdown-card');
                if (card) card.style.display = 'none';
            }
        });

        function filterRepos(query) {
            const container = document.getElementById('repo-list-options');
            if (!container) return;
            const filtered = globalRepos.filter(r => r.name.toLowerCase().includes(query.toLowerCase()));
            renderRepoOptions(filtered);
        }

        function renderRepoOptions(repos) {
            const container = document.getElementById('repo-list-options');
            if (!container) return;
            if (repos.length === 0) {
                container.innerHTML = '<div class="repo-option-item" style="color: var(--text-secondary); cursor: default;">No repositories found</div>';
                return;
            }
            container.innerHTML = repos.map(repo => `
                <div class="repo-option-item" onclick="selectRepo('${repo.url}', '${repo.name}', ${repo.private})">
                    <i class="fa-solid ${repo.private ? 'fa-lock' : 'fa-globe'}" style="color: ${repo.private ? 'var(--warning)' : 'var(--success)'}; width: 16px;"></i>
                    <span>${repo.name}</span>
                </div>
            `).join('');
        }

        function selectRepo(url, name, isPrivate) {
            document.getElementById('repoUrl').value = url;
            const label = document.getElementById('selected-repo-label');
            if(label) label.innerHTML = `<i class="fa-solid ${isPrivate ? 'fa-lock' : 'fa-globe'}" style="color: ${isPrivate ? 'var(--warning)' : 'var(--success)'}; margin-right: 8px;"></i> <span style="color: var(--text-primary); font-weight: 500;">${name}</span>`;
            document.getElementById('repo-dropdown-card').style.display = 'none';
        }

        <% if(user && user.githubId) { %>
            fetch('/deploy/github-repos')
                .then(res => res.json())
                .then(data => {
                    if(data.success && data.repos) {
                        globalRepos = data.repos;
                        renderRepoOptions(globalRepos);
                    } else {
                        document.getElementById('repo-list-options').innerHTML = '<div class="repo-option-item">Failed to load repos</div>';
                    }
                })
                .catch(() => {
                    document.getElementById('repo-list-options').innerHTML = '<div class="repo-option-item">Network error loading repos</div>';
                });
        <% } %>

        async function scanBlueprint() {
            const repoUrl = document.getElementById('repoUrl').value.trim();
            if (!repoUrl) return showToast("Enter a repository URL", "var(--danger)");
            const scanBtn = document.getElementById('scan-btn');
            scanBtn.disabled = true; scanBtn.innerText = 'Scanning...';
            try {
                const res = await fetch('/deploy/scan', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ repoUrl }) });
                const data = await res.json();
                if (data.success) {
                    const inputContainer = document.getElementById('dynamic-inputs');
                    inputContainer.innerHTML = '';
                    rotateName();
                    if (!data.requirements || data.requirements.length === 0) {
                        inputContainer.innerHTML = '<p class="promo-text">No config variables found. Add them manually below.</p>';
                        addEnvRow();
                    } else {
                        data.requirements.forEach(item => { if (item.key !== 'HEROKU_API_KEY') createVarInput(inputContainer, item.key, item.value, item.description); });
                    }
                    document.getElementById('dynamic-area').style.display = 'block';
                    document.getElementById('launch-btn').onclick = () => launchToGrid(data.repo);
                    validateForm();
                    showToast("Scan complete", "var(--success)");
                } else {
                    document.getElementById('dynamic-area').style.display = 'block';
                    document.getElementById('dynamic-inputs').innerHTML = '<p class="promo-text">No configuration file found. Add variables manually.</p>';
                    document.getElementById('launch-btn').onclick = () => launchToGrid(repoUrl);
                    rotateName(); validateForm();
                    showToast(data.message || "Manual mode ready", "var(--warning)");
                }
            } catch (e) { showToast("Scan failed", "var(--danger)"); }
            finally { scanBtn.disabled = false; scanBtn.innerText = 'Scan'; }
        }

        function createVarInput(container, key, val, desc) {
            const div = document.createElement('div');
            div.className = 'env-row';
            div.innerHTML = `<input type="text" class="env-key-input" value="${escapeHtml(key || '')}" placeholder="KEY"><input type="text" class="env-var-input" value="${escapeHtml(val || '')}" placeholder="${escapeHtml(desc || 'VALUE')}"><button class="small-btn" onclick="this.parentElement.remove(); validateForm();"><i class="fa-solid fa-trash"></i></button>`;
            container.appendChild(div);
            div.querySelectorAll('input').forEach(input => input.addEventListener('input', validateForm));
        }

        function addEnvRow() { createVarInput(document.getElementById('dynamic-inputs'), "", "", ""); validateForm(); }

        function validateForm() {
            const launchBtn = document.getElementById('launch-btn');
            if (!launchBtn) return;
            let valid = true;
            document.querySelectorAll('#dynamic-inputs .env-row').forEach(row => {
                if (!row.querySelector('.env-key-input')?.value.trim() || !row.querySelector('.env-var-input')?.value.trim()) valid = false;
            });
            launchBtn.disabled = !valid;
        }

        async function launchToGrid(repoUrl) {
            const configVars = { "APP_NAME": currentGeneratedName };
            document.querySelectorAll('#dynamic-inputs .env-row').forEach(row => {
                const k = row.querySelector('.env-key-input')?.value.trim();
                const v = row.querySelector('.env-var-input')?.value.trim();
                if (k) configVars[k] = v;
            });
            if (document.getElementById('procfile-toggle').checked) configVars["USE_PROCFILE"] = "true";

            const launchBtn = document.getElementById('launch-btn');
            launchBtn.disabled = true; launchBtn.innerText = 'Deploying...';
            try {
                const res = await fetch('/deploy/launch', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ repoUrl, configVars }) });
                const data = await res.json();
                if (data.success) {
                    latestLiveUrl = data.customUrl || `https://${data.appName}.gathuo.app`;
                    document.getElementById('deploy-success').style.display = 'block';
                    document.getElementById('live-url').innerText = latestLiveUrl;
                    document.getElementById('live-url').href = latestLiveUrl;
                    showToast("Deployment initialized", "var(--success)");
                    setTimeout(() => window.location.reload(), 2500);
                } else { showToast(data.message || "Deployment failed", "var(--danger)"); }
            } catch (e) { showToast("Request failed", "var(--danger)"); }
            finally { launchBtn.disabled = false; launchBtn.innerText = 'Deploy Now'; }
        }

        async function terminateUnit(appName) {
            if (!confirm("Terminate this unit permanently?")) return;
            const res = await fetch('/deploy/terminate', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ appName }) });
            const data = await res.json();
            if (data.success) { showToast("Unit terminated", "var(--success)"); setTimeout(() => window.location.reload(), 1000); }
            else { showToast(data.message || "Termination failed", "var(--danger)"); }
        }

        function openApp(appName) { window.open(`https://${appName}.gathuo.app`, '_blank'); }
        function copyText(text) { navigator.clipboard.writeText(text); showToast("Copied to clipboard", "var(--border-focus)"); }

        async function loadConfig(appName) {
            document.getElementById('env').scrollIntoView();
            document.getElementById('config-app-name').value = appName;
            const editor = document.getElementById('config-editor');
            editor.innerHTML = '<p class="promo-text">Fetching configuration...</p>';
            try {
                const res = await fetch(`/deploy/config/${appName}`);
                const data = await res.json();
                editor.innerHTML = "";
                const config = data.config || {};
                Object.keys(config).forEach(k => addConfigRow(k, config[k]));
                if (Object.keys(config).length === 0) editor.innerHTML = '<p class="promo-text">No variables found. Add new ones below.</p>';
                showToast("Configuration loaded", "var(--success)");
            } catch (e) { editor.innerHTML = '<p class="promo-text" style="color:var(--danger);">Failed to load configuration.</p>'; }
        }

        function addConfigRow(key = "", value = "") {
            const row = document.createElement('div');
            row.className = 'env-row';
            row.innerHTML = `<input type="text" class="config-key" value="${escapeHtml(key)}" placeholder="KEY"><input type="text" class="config-value" value="${escapeHtml(value)}" placeholder="VALUE"><button class="small-btn" onclick="this.parentElement.remove();"><i class="fa-solid fa-trash"></i></button>`;
            document.getElementById('config-editor').appendChild(row);
        }

        async function saveConfig() {
            const appName = document.getElementById('config-app-name').value.trim();
            if (!appName) return showToast("Select an app to configure", "var(--danger)");
            const body = {};
            document.querySelectorAll('#config-editor .env-row').forEach(row => {
                const k = row.querySelector('.config-key')?.value.trim();
                const v = row.querySelector('.config-value')?.value.trim();
                if (k) body[k] = v;
            });
            try {
                const res = await fetch(`/deploy/config/${appName}`, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
                const data = await res.json();
                if (data.updated || data.success) showToast("Configuration saved", "var(--success)");
                else showToast("Failed to save configuration", "var(--danger)");
            } catch (e) { showToast("Network error", "var(--danger)"); }
        }

        function escapeHtml(str) {
            return String(str).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
        }

        <% if(user && user.hasDeployed) { %>
            let lastLogs = "";
            setInterval(() => {
                fetch('/deploy/logs/<%= user.activeUnit %>')
                    .then(res => res.json())
                    .then(data => {
                        const lb = document.getElementById('log-stream');
                        if (lb && data.logs && data.logs !== lastLogs) {
                            lastLogs = data.logs;
                            lb.innerText = data.logs;
                            lb.scrollTop = lb.scrollHeight;
                        }
                    }).catch(() => {});
            }, 5000);
        <% } %>
    </script>
</body>
</html>
